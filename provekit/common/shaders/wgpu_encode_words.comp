layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

struct FieldWordsParams {
    uint total_elements;
    uint _padding0;
    uint _padding1;
    uint _padding2;
};

layout(std430, binding = 0) readonly buffer InputBuffer {
    Fe input_values[];
};

layout(std430, binding = 1) buffer OutputBuffer {
    uint output_words[];
};

layout(std430, binding = 2) readonly buffer ParamsBuffer {
    FieldWordsParams params;
};

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.total_elements) {
        return;
    }

    Fe canonical = from_mont(input_values[gid]);
    uint dst = gid * 8u;
    for (uint limb = 0u; limb < 8u; ++limb) {
        output_words[dst + limb] = canonical.limbs[limb];
    }
}
