layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

struct HashManyParams {
    uint size;
    uint count;
    uint input_offset_words;
    uint output_offset_words;
};

layout(std430, binding = 0) readonly buffer InputBuffer {
    uint input_words[];
};

layout(std430, binding = 1) buffer OutputBuffer {
    uint output_words[];
};

layout(std430, binding = 2) readonly buffer ParamsBuffer {
    HashManyParams params;
};

const uint SHA256_K[64] = uint[](
    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u,
    0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
    0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u,
    0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
    0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu,
    0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
    0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u,
    0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
    0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u,
    0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u,
    0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
    0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u,
    0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
    0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u
);

uint rotr32(uint x, uint n) {
    return (x >> n) | (x << (32u - n));
}

uint ch(uint x, uint y, uint z) {
    return (x & y) ^ ((~x) & z);
}

uint maj(uint x, uint y, uint z) {
    return (x & y) ^ (x & z) ^ (y & z);
}

uint big_sigma0(uint x) {
    return rotr32(x, 2u) ^ rotr32(x, 13u) ^ rotr32(x, 22u);
}

uint big_sigma1(uint x) {
    return rotr32(x, 6u) ^ rotr32(x, 11u) ^ rotr32(x, 25u);
}

uint small_sigma0(uint x) {
    return rotr32(x, 7u) ^ rotr32(x, 18u) ^ (x >> 3u);
}

uint small_sigma1(uint x) {
    return rotr32(x, 17u) ^ rotr32(x, 19u) ^ (x >> 10u);
}

uint load_input_byte(uint base_word, uint byte_index) {
    uint word = input_words[base_word + (byte_index >> 2u)];
    uint shift = (3u - (byte_index & 3u)) * 8u;
    return (word >> shift) & 0xffu;
}

uint store_digest_word(uint x) {
    return x;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.count) {
        return;
    }

    uint offset_words = params.input_offset_words + gid * (params.size >> 2u);
    uint total_blocks = (params.size + 9u + 63u) / 64u;
    uint total_padded_len = total_blocks * 64u;
    uint total_words = total_blocks * 16u;
    uint bit_len_lo = params.size << 3u;
    uint bit_len_hi = params.size >> 29u;

    uint h0 = 0x6a09e667u;
    uint h1 = 0xbb67ae85u;
    uint h2 = 0x3c6ef372u;
    uint h3 = 0xa54ff53au;
    uint h4 = 0x510e527fu;
    uint h5 = 0x9b05688cu;
    uint h6 = 0x1f83d9abu;
    uint h7 = 0x5be0cd19u;

    for (uint block = 0u; block < total_blocks; ++block) {
        uint w[64];

        for (uint i = 0u; i < 16u; ++i) {
            uint word = 0u;
            for (uint j = 0u; j < 4u; ++j) {
                uint idx = block * 64u + i * 4u + j;
                uint byte = 0u;
                if (idx < params.size) {
                    byte = load_input_byte(offset_words, idx);
                } else if (idx == params.size) {
                    byte = 0x80u;
                } else if (idx >= total_padded_len - 8u) {
                    uint shift = (total_padded_len - 1u - idx) * 8u;
                    byte = shift >= 32u ? (bit_len_hi >> (shift - 32u)) & 0xffu
                                        : (bit_len_lo >> shift) & 0xffu;
                }
                word = (word << 8u) | byte;
            }
            w[i] = word;
        }

        for (uint i = 16u; i < 64u; ++i) {
            w[i] = small_sigma1(w[i - 2u]) + w[i - 7u] + small_sigma0(w[i - 15u]) + w[i - 16u];
        }

        uint a = h0;
        uint b = h1;
        uint c = h2;
        uint d = h3;
        uint e = h4;
        uint f = h5;
        uint g = h6;
        uint h = h7;

        for (uint i = 0u; i < 64u; ++i) {
            uint t1 = h + big_sigma1(e) + ch(e, f, g) + SHA256_K[i] + w[i];
            uint t2 = big_sigma0(a) + maj(a, b, c);
            h = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
        }

        h0 += a;
        h1 += b;
        h2 += c;
        h3 += d;
        h4 += e;
        h5 += f;
        h6 += g;
        h7 += h;
    }

    uint out_base = params.output_offset_words + gid * 8u;
    output_words[out_base + 0u] = store_digest_word(h0);
    output_words[out_base + 1u] = store_digest_word(h1);
    output_words[out_base + 2u] = store_digest_word(h2);
    output_words[out_base + 3u] = store_digest_word(h3);
    output_words[out_base + 4u] = store_digest_word(h4);
    output_words[out_base + 5u] = store_digest_word(h5);
    output_words[out_base + 6u] = store_digest_word(h6);
    output_words[out_base + 7u] = store_digest_word(h7);
}
